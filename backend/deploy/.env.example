# Copy to .env and fill in. Never commit .env.
DATABASE__PASSWORD=
AUTH__JWT_SECRET=
INGEST__SERVICE_KEY=

# Demo only: every phone signs in with this code. Leave empty to have codes
# sent through OTPIQ, or written to the server log when OTPIQ__API_KEY is
# empty too. Setting both stops the server at start-up.
AUTH__FIXED_SIGN_IN_CODE=

# Where the Farm Doctor service answers, as seen from inside the API
# container (127.0.0.1 there is the container itself). Empty means
# http://127.0.0.1:8090, so Ask the Doctor answers 502 until it is set.
DOCTOR_URL=

# OTPIQ delivers the sign-in code by SMS, WhatsApp or Telegram.
OTPIQ__API_KEY=
# One of: auto, whatsapp-sms, telegram-sms, sms, whatsapp, telegram.
OTPIQ__PROVIDER=auto
OTPIQ__SENDER_ID=
OTPIQ__BASE_URL=https://api.otpiq.com/api/
OTPIQ__TIMEOUT_SECONDS=15

PUBLIC_PORT=8790
CARGO_BUILD_JOBS=2

# Websites allowed to call the API from a browser (comma list, no "*").
# Example: HTTP__CORS_ORIGINS=https://jutyar.example,http://127.0.0.1:5173
HTTP__CORS_ORIGINS=

# Whether GET /v1/stats/farms (farm totals, no login) answers. false: 404.
STATS__PUBLIC_FARM_TOTALS=true
