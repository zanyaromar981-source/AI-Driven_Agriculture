# Copy to .env and fill in. Never commit .env.
DATABASE__PASSWORD=
AUTH__JWT_SECRET=
INGEST__SERVICE_KEY=

# Demo only: every phone signs in with this code. Leave empty to have codes
# written to the server log instead.
AUTH__FIXED_SIGN_IN_CODE=

# Where the Farm Doctor service answers, as seen from inside the API
# container (127.0.0.1 there is the container itself). Empty means
# http://127.0.0.1:8090, so Ask the Doctor answers 502 until it is set.
DOCTOR_URL=

PUBLIC_PORT=8790
CARGO_BUILD_JOBS=2
