[Unit]
Description=Farm Doctor dams runner: lake area of Dukan and Darbandikhan from Sentinel-2
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/farm-doctor/backend/jobs
EnvironmentFile=/opt/farm-doctor/backend/deploy/.env
Environment=FARM_DOCTOR_API=http://127.0.0.1:8790/v1
ExecStart=/usr/bin/python3 /opt/farm-doctor/backend/jobs/report_run.py dams /usr/bin/python3 /opt/farm-doctor/backend/jobs/dams_runner.py
Nice=10
TimeoutStartSec=1800
