[Unit]
Description=Farm Doctor farm alerts: alerts for each farm from the stored fires and weekly plan
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/farm-doctor/backend/jobs
EnvironmentFile=/opt/farm-doctor/backend/deploy/.env
Environment=FARM_DOCTOR_API=http://127.0.0.1:8790/v1
Environment=FARM_ALERTS_LOCK=/opt/farm-doctor/cache/farm_alerts.lock
ExecStart=/usr/bin/python3 /opt/farm-doctor/backend/jobs/farm_alerts.py
Nice=10
TimeoutStartSec=600
