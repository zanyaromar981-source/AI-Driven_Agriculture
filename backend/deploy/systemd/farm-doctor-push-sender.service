[Unit]
Description=Farm Doctor push sender: red alerts to farmers' phones through Firebase
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/farm-doctor/backend/jobs
EnvironmentFile=/opt/farm-doctor/backend/deploy/.env
Environment=FARM_DOCTOR_API=http://127.0.0.1:8790/v1
ExecStart=/usr/bin/python3 /opt/farm-doctor/backend/jobs/push_sender.py
Nice=10
TimeoutStartSec=300
