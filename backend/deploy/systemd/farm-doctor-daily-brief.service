[Unit]
Description=Farm Doctor daily brief: an AI agent summarises the day for the region and its districts
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/farm-doctor/backend/jobs
EnvironmentFile=/opt/farm-doctor/backend/deploy/.env
Environment=FARM_DOCTOR_API=http://127.0.0.1:8790/v1
Environment=HOME=/root
ExecStart=/usr/bin/python3 /opt/farm-doctor/backend/jobs/daily_brief.py
Nice=10
TimeoutStartSec=2400
