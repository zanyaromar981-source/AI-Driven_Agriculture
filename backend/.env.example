DATABASE__HOST=localhost
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=mysecretpassword
DATABASE__NAME=farm_doctor

# Signs the app's own sign-in tokens. Use a long random value outside local work.
AUTH__JWT_SECRET=
# AUTH__ISSUER=farm-doctor-api
# AUTH__AUDIENCE=farm-doctor-app
# AUTH__TOKEN_TTL_DAYS=30

# Sign-in codes. No SMS provider is wired yet: the code is written to the
# server log. Set a fixed code only for a demo; it lets anyone who knows it
# sign in as any phone.
# AUTH__FIXED_SIGN_IN_CODE=123456
# AUTH__CODE_VALID_MINUTES=10
# AUTH__CODE_RESEND_AFTER_SECONDS=60
# AUTH__CODE_MAX_ATTEMPTS=5

LOG_LEVEL=info

# OTEL_LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=farm-doctor-api

# The data jobs send this in the X-Service-Key header to write their results.
# Leave it empty and nothing can be written through /v1/ingest.
INGEST__SERVICE_KEY=

FARMS__MAX_FARMS_PER_USER=20
FARMS__MAX_CELLS_PER_FARM=50000
