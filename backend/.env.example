DATABASE__HOST=localhost
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=mysecretpassword
DATABASE__NAME=farm_doctor

# Signs the app's own sign-in tokens. Use a long random value outside local work.
AUTH__JWT_SECRET=
# AUTH__ISSUER=farm-doctor-api
# AUTH__AUDIENCE=farm-doctor-app
# AUTH__TOKEN_TTL_DAYS=30

# Sign-in codes. Without an OTPIQ key (below) the code is written to the
# server log. Set a fixed code only for a demo; it lets anyone who knows it
# sign in as any phone. A fixed code together with an OTPIQ key stops the
# server at start-up.
# AUTH__FIXED_SIGN_IN_CODE=123456
# AUTH__CODE_VALID_MINUTES=10
# AUTH__CODE_RESEND_AFTER_SECONDS=60
# AUTH__CODE_MAX_ATTEMPTS=5
# AUTH__CODE_REUSE_WINDOW_SECONDS=120

# OTPIQ delivers the sign-in code by SMS, WhatsApp or Telegram. Leave the key
# empty and nothing is sent: the code is written to the server log.
OTPIQ__API_KEY=
# One of: auto, whatsapp-sms, telegram-sms, sms, whatsapp, telegram.
# OTPIQ__PROVIDER=auto
# OTPIQ__SENDER_ID=
# OTPIQ__BASE_URL=https://api.otpiq.com/api/
# OTPIQ__TIMEOUT_SECONDS=15

LOG_LEVEL=info

# OTEL_LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=farm-doctor-api

# The data jobs send this in the X-Service-Key header to write their results.
# Leave it empty and nothing can be written through /v1/ingest.
INGEST__SERVICE_KEY=

# Where the local Farm Doctor service answers POST /ask. Ask the Doctor
# passes questions there; the backend calls no AI itself.
# DOCTOR_URL=http://127.0.0.1:8090

FARMS__MAX_FARMS_PER_USER=20
FARMS__MAX_CELLS_PER_FARM=50000

# Websites allowed to call the API from a browser (comma list, no "*").
# Example: HTTP__CORS_ORIGINS=https://jutyar.example,http://127.0.0.1:5173
HTTP__CORS_ORIGINS=

# Whether GET /v1/stats/farms (farm totals, no login) answers. false: 404.
# STATS__PUBLIC_FARM_TOTALS=true
